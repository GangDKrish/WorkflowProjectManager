<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="PanelForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1E88E5"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#094771"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#4EC9B0"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#CE9178"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F48771"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#569CD6"/>

    <!-- Control Brushes -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#0E639C"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1177BB"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#094771"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="ButtonDisabledBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="#808080"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="NavPressedBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#252526"/>
    <SolidColorBrush x:Key="DataGridLineBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="DataGridAltRowBrush" Color="#2D2D30"/>

</ResourceDictionary>
