<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F6FA"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2C3E50"/>
    <SolidColorBrush x:Key="PanelForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#212121"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#757575"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2196F3"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#E3F2FD"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9800"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F44336"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#2196F3"/>

    <!-- Control Brushes -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2196F3"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#0D47A1"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="ButtonDisabledBrush" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="#757575"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#34495E"/>
    <SolidColorBrush x:Key="NavPressedBrush" Color="#1ABC9C"/>
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="DataGridLineBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="DataGridAltRowBrush" Color="#FAFAFA"/>

</ResourceDictionary>