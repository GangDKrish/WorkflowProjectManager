<UserControl x:Class="WorkflowProjectManager.WorkFlow.Views.SprintPlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Sprint Planning" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

        <GroupBox Grid.Row="1" Header="Create New Sprint" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Name:" FontWeight="Bold"/>
                    <TextBox Width="180" Height="28" Text="{Binding NewSprintName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Start:" FontWeight="Bold"/>
                    <DatePicker SelectedDate="{Binding NewStartDate}" Width="120"/>
                </StackPanel>
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="End:" FontWeight="Bold"/>
                    <DatePicker SelectedDate="{Binding NewEndDate}" Width="120"/>
                </StackPanel>
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Goal Points:" FontWeight="Bold"/>
                    <TextBox Width="80" Height="28" Text="{Binding NewGoalPoints, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <Button Content="Create Sprint" Command="{Binding CreateSprintCommand}" 
                        VerticalAlignment="Bottom" Height="30" Padding="15,4"
                        Background="#43A047" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Sprint:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="250" ItemsSource="{Binding Sprints}" SelectedItem="{Binding SelectedSprint}" DisplayMemberPath="Name"/>
            <Button Content="Add Selected to Sprint" Command="{Binding AddToSprintCommand}" Margin="15,0,0,0" Padding="12,4"
                    Style="{StaticResource DefaultButtonStyle}"/>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding BacklogItems}" SelectedItem="{Binding SelectedBacklogItem}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="120"/>
                <DataGridTextColumn Header="Story Points" Binding="{Binding StoryPoints}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
