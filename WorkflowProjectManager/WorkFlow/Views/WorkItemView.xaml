<UserControl x:Class="WorkflowProjectManager.WorkFlow.Views.WorkItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:WorkflowProjectManager.WorkFlow.Models.Enums"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
	<Grid Margin="20">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="2*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Left side - Work Items List -->
		<Grid Grid.Column="0" Margin="0,0,10,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<TextBlock Text="Work Items" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
			<Button Grid.Row="1" Content="Refresh" Command="{Binding RefreshCommand}"
                    Width="90" HorizontalAlignment="Left" Margin="0,0,0,10"
                    Background="#1976D2" Foreground="White" Height="30"/>

			<DataGrid Grid.Row="2" ItemsSource="{Binding WorkItems}"
                      SelectedItem="{Binding SelectedWorkItem}"
                      AutoGenerateColumns="False" IsReadOnly="True">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
					<DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
					<DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
					<DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80"/>
					<DataGridTextColumn Header="Points" Binding="{Binding StoryPoints}" Width="60"/>
					<DataGridTextColumn Header="Assigned Developer" Binding="{Binding AssignedDeveloper.Name}" Width="140"/>
				</DataGrid.Columns>
			</DataGrid>

			<Button Grid.Row="3" Content="Delete Selected" Command="{Binding DeleteCommand}"
					Width="120" HorizontalAlignment="Left" Margin="0,10,0,0"
					Background="#D32F2F" Foreground="White" Height="30">
				<Button.Style>
					<Style TargetType="Button">
						<Setter Property="Visibility" Value="Visible"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding SelectedWorkItem}" Value="{x:Null}">
								<Setter Property="Visibility" Value="Collapsed"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
		</Grid>

		<!-- Right side - Add New Work Item Form -->
		<GroupBox Grid.Column="1" Header="Add New Work Item" Padding="10">
			<StackPanel>
				<TextBlock Text="Title:" FontWeight="Bold" Margin="0,5,0,2"/>
				<TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Height="30"/>

				<TextBlock Text="Description:" FontWeight="Bold" Margin="0,10,0,2"/>
				<TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                         Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

				<TextBlock Text="Type:" FontWeight="Bold" Margin="0,10,0,2"/>
				<ComboBox SelectedItem="{Binding NewType}" Height="30">
					<ComboBox.Items>
						<enums:WorkItemType>UserStory</enums:WorkItemType>
						<enums:WorkItemType>Defect</enums:WorkItemType>
						<enums:WorkItemType>TechTask</enums:WorkItemType>
					</ComboBox.Items>
				</ComboBox>

				<TextBlock Text="Priority:" FontWeight="Bold" Margin="0,10,0,2"/>
				<ComboBox SelectedItem="{Binding NewPriority}" Height="30">
					<ComboBox.Items>
						<enums:Priority>Low</enums:Priority>
						<enums:Priority>Medium</enums:Priority>
						<enums:Priority>High</enums:Priority>
						<enums:Priority>Critical</enums:Priority>
					</ComboBox.Items>
				</ComboBox>

				<TextBlock Text="Story Points:" FontWeight="Bold" Margin="0,10,0,2"/>
				<TextBox Text="{Binding NewStoryPoints, UpdateSourceTrigger=PropertyChanged}" Height="30"/>

				<Button Content="Add Work Item" Command="{Binding AddCommand}"
                        Margin="0,20,0,0" Height="35"
                        Background="#43A047" Foreground="White" FontWeight="Bold"/>
			</StackPanel>
		</GroupBox>
	</Grid>
</UserControl>